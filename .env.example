# claudebot configuration.
#
# Copy to ~/.claudebot/.env (or run `claudebot setup`, which writes it for you).
# Every key may also be set as an environment variable of the same name.
#
# Running a SECOND bot? Don't hand-edit this — use a named instance:
#   claudebot --instance work setup
# That writes ~/.claudebot/instances/work/.env and runs as its own service.

# --- Required ---------------------------------------------------------------

# Token from @BotFather (https://t.me/BotFather → /newbot).
CLAUDEBOT_TELEGRAM_BOT_TOKEN=123456789:AA...your-token...

# Comma-separated Telegram numeric user IDs allowed to use the bot.
# Get yours from @userinfobot. EMPTY = nobody can use it (locked).
# Keep this to yourself — letting others prompt through your subscription is
# account sharing and a ban risk.
CLAUDEBOT_ALLOWED_USER_IDS=111111111

# --- Claude Code ------------------------------------------------------------

# Path to the claude executable (default: found on PATH).
# CLAUDEBOT_CLAUDE_BINARY=claude

# Directory Claude runs in — it can read/write here. Default: your home dir.
CLAUDEBOT_WORKING_DIR=/home/you/projects

# Model alias or full name. Blank = Claude Code's default.
# CLAUDEBOT_MODEL=sonnet

# Headless permission mode:
#   bypassPermissions  never blocks — best for an unattended bot (FULL tool access)
#   acceptEdits        auto-approves edits; may stall a turn on other tools
#   default / plan     likely to stall headless (no interactive prompt)
CLAUDEBOT_PERMISSION_MODE=bypassPermissions

# Effort level: low | medium | high | xhigh | max. Blank = default.
# CLAUDEBOT_EFFORT=high

# Extra system prompt, or a file whose contents are appended to it.
# CLAUDEBOT_APPEND_SYSTEM_PROMPT=You are running as Samuel's Telegram assistant.
# CLAUDEBOT_SYSTEM_PROMPT_FILE=/home/you/.claudebot/persona.md

# Restrict tools (comma-separated). Empty = no restriction.
# CLAUDEBOT_ALLOWED_TOOLS=Read,Edit,Bash
# CLAUDEBOT_DISALLOWED_TOOLS=WebFetch

# --- Behaviour --------------------------------------------------------------

# Stream the reply into Telegram as Claude types it.
# CLAUDEBOT_STREAM_PARTIALS=true

# Render Claude's Markdown (bold, code, tables) as Telegram formatting.
# Set to false to receive raw plain text instead.
# CLAUDEBOT_MARKDOWN=true

# Minimum seconds between streaming message edits (Telegram flood control).
# CLAUDEBOT_EDIT_INTERVAL=1.3

# Kill a chat's idle claude child after N seconds (0 = never). Context is kept;
# the next message resumes it with --resume.
# CLAUDEBOT_IDLE_TIMEOUT=3600

# Abort a turn that produces no result after N seconds (0 = no limit). Stops a
# hung tool from wedging the chat; the session resets and resumes on the next message.
# CLAUDEBOT_TURN_TIMEOUT=1800

# Append a system-prompt instruction telling Claude to treat attached/forwarded/
# fetched content as untrusted DATA, never instructions (content-injection guard).
# CLAUDEBOT_SAFETY_PREAMBLE=true

# Append a token/cost footer after each reply.
# CLAUDEBOT_SHOW_COST=false

# Log verbosity: DEBUG | INFO | WARNING | ERROR.
# CLAUDEBOT_LOG_LEVEL=INFO
